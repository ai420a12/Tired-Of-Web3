# Copy to .env.local for localhost testing (optional)
# Add the same keys in Vercel → Project → Settings → Environment Variables
# See WL-DATA.md — "Never break again" checklist.

# PRIMARY (required on Vercel unless using webhook fallback)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# FALLBACK — Discord webhook (or Slack-compatible). One env var keeps WL alive
# if Supabase is missing on Vercel. Local JSON is NEVER used on Vercel.
# WL_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# Optional: protect full submission list via GET /api/wl
# WL_ADMIN_SECRET=pick-a-long-random-string

# Optional — HOOD_RPC live OpenSea sales / collection stats
# Without this, /hood-rpc still shows real Robinhood collection names + images
# and GeckoTerminal memecoins. Add key on Vercel for live OS sales feed.
# OpenSea API — one key, or comma-separated keys you already own (rotated on 429/503)
# OPENSEA_API_KEY=your_opensea_api_key
# OPENSEA_API_KEYS=key1,key2,key3

# Optional ETH live-sales backup when OpenSea is down
# ALCHEMY_API_KEY=your_alchemy_key
